# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr

# Environment. `*.local` covers .env.local; the explicit entries below make it
# obvious that real env files must never be committed. .env.example is tracked.
*.local
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Playwright artefacts. Traces and screenshots are produced on failure only and
# are never worth committing.
/test-results
/playwright-report
/blob-report
/playwright/.cache
