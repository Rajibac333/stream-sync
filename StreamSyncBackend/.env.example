# =============================================================================
# StreamSync backend environment
#
# Copy to `.env` (git-ignored) and fill in real values:
#
#     cp .env.example .env
#
# NEVER commit `.env`. Every value below that is marked secret must be
# generated per environment and stored in a secret manager in production.
# (README §25, §29)
# =============================================================================

# -----------------------------------------------------------------------------
# Core Django
# -----------------------------------------------------------------------------

# Which settings module to load: config.settings.development
#                              | config.settings.production
#                              | config.settings.test
DJANGO_SETTINGS_MODULE=config.settings.development

# SECRET. Signs sessions and password-reset tokens. Generate a unique value per
# environment; production refuses to start without one:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Never true in production — DEBUG leaks settings and stack traces.
DJANGO_DEBUG=True

# Comma-separated hostnames this instance answers for. Required in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

DJANGO_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Database (PostgreSQL — required, SQLite is not supported)
# -----------------------------------------------------------------------------

# Contains the database password: treat the whole value as a secret.
DATABASE_URL=postgres://streamsync:streamsync@localhost:5432/streamsync

# Seconds to keep a database connection open for reuse. 0 disables pooling.
DJANGO_CONN_MAX_AGE=60

# -----------------------------------------------------------------------------
# CORS
#
# Exact scheme + host + port of every browser origin allowed to call the API.
# Wildcards are not permitted: the API sends credentials. (README §25)
# -----------------------------------------------------------------------------

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# JWT (README §19)
#
# The access token is short-lived and returned in the response body. The
# refresh token is long-lived and delivered ONLY as an httpOnly cookie, so
# browser JavaScript can never read it.
# -----------------------------------------------------------------------------

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# SECRET. Optional — defaults to DJANGO_SECRET_KEY. Set a separate value to be
# able to rotate JWT signing without also invalidating sessions and every
# other signed value in the project.
# JWT_SIGNING_KEY=

# Refresh cookie. Scoped to the auth endpoints so it is not attached to
# ordinary API requests.
JWT_REFRESH_COOKIE_NAME=streamsync_refresh
JWT_REFRESH_COOKIE_PATH=/api/auth/

# False for local http development. ALWAYS True in production, where it is
# forced on regardless of this value.
JWT_REFRESH_COOKIE_SECURE=False

# "Lax" while the frontend and API share a registrable domain
# (localhost:5173 -> localhost:8000, app.example.com -> api.example.com).
# A genuinely cross-site deployment needs "None", which browsers only honour
# together with Secure.
JWT_REFRESH_COOKIE_SAMESITE=Lax

# -----------------------------------------------------------------------------
# Google Sign-In
#
# Not secret — a client ID identifies the application the same way a domain
# name does, and Google's own docs say it is safe in frontend code. It is
# still per-environment: create an OAuth 2.0 Client ID (type "Web application")
# in the Google Cloud Console, add http://localhost:5173 (and your production
# origin) under "Authorized JavaScript origins", and paste the id below. Must
# match VITE_GOOGLE_CLIENT_ID in the frontend's own .env — same value, both
# places. Leaving this unset disables POST /api/auth/google/ (503) and the
# frontend hides the button.
# -----------------------------------------------------------------------------

# GOOGLE_OAUTH_CLIENT_ID=

# -----------------------------------------------------------------------------
# Rate limiting (README §24)
# -----------------------------------------------------------------------------

DJANGO_THROTTLE_ANON=60/min
DJANGO_THROTTLE_USER=1000/hour

# Login and registration, per client IP: the caller is anonymous by definition,
# so the address is the only thing there is to key on.
DJANGO_THROTTLE_LOGIN=10/min
DJANGO_THROTTLE_REGISTER=5/hour

# Refresh, per account rather than per address — it fires on every page load,
# and a per-IP budget would sign out everyone behind one office connection.
DJANGO_THROTTLE_REFRESH=240/hour

# Invitations, per user. A write that reaches a person, so it is capped well
# below the general per-user limit.
DJANGO_THROTTLE_INVITE=30/hour

# -----------------------------------------------------------------------------
# Service identity — reported by GET /api/health/
# -----------------------------------------------------------------------------

SERVICE_VERSION=1.0.0
SERVICE_ENVIRONMENT=local

# -----------------------------------------------------------------------------
# Production-only transport security. Defaults are already secure; these exist
# to relax them in a staging environment that terminates TLS differently.
# -----------------------------------------------------------------------------

# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# Only enable preload once every subdomain genuinely serves HTTPS. Submitting a
# domain to the preload list is difficult to reverse.
# DJANGO_SECURE_HSTS_PRELOAD=True

# -----------------------------------------------------------------------------
# Redis (README §23)
#
# Backs three things: the cache, the WebSocket presence roster, and the Django
# Channels layer. Required — the channel layer is how a broadcast from one
# worker reaches sockets held by another.
# -----------------------------------------------------------------------------

REDIS_URL=redis://localhost:6379/0

# Development escape hatch for a laptop with no Redis installed. Substitutes
# in-process backends and runs Celery tasks inline. Single-worker only — never
# set this outside development. See docs/WEBSOCKET_PROTOCOL.md.
# DJANGO_USE_REDIS=False

# -----------------------------------------------------------------------------
# Celery (README §22)
#
# Both default to REDIS_URL. Override only to put the queue on separate
# infrastructure from the cache.
# -----------------------------------------------------------------------------

# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# AI (README §14, Milestone 9)
#
# SECRET. Server-side only — it must never reach the browser, and there is no
# VITE_-prefixed equivalent, because anything with that prefix is shipped to
# every visitor. The browser talks to Django; Django talks to the provider.
# (frontend CLAUDE.md §9, §50)
#
# Leaving AI_API_KEY unset is a supported configuration, not a broken one: the
# assistant then runs the deterministic provider, which reads the document and
# answers with rules. Every result it returns is stamped `mock-heuristic` so
# the UI can say what produced it.
# -----------------------------------------------------------------------------

# AI_API_KEY=

# `anthropic` when a key is present, `mock` otherwise. Set explicitly to run the
# deterministic provider even with a key configured, or to pick `groq` instead
# of Anthropic — same key variable above, just a Groq key
# (https://console.groq.com/keys) instead of an Anthropic one.
# AI_PROVIDER=mock

# Defaults follow AI_PROVIDER (see config/settings/base.py): claude-opus-5 for
# anthropic, openai/gpt-oss-20b for groq. Override only to pick a different
# model within whichever provider is selected.
# AI_MODEL=claude-opus-5
# AI_EFFORT=medium

# Per-request budget in seconds, and one retry on top of the first attempt.
# AI_TIMEOUT_SECONDS=45
# AI_MAX_RETRIES=1

# Response ceiling, and how much of a document the assistant may read. Longer
# documents are truncated, and the prompt says so.
# AI_MAX_OUTPUT_TOKENS=8000
# AI_MAX_DOCUMENT_CHARS=60000

# Per-user rate limits for the AI endpoints. The only requests in the product
# that cost money at a third party. (README §24)
# DJANGO_THROTTLE_AI_BURST=10/min
# DJANGO_THROTTLE_AI=60/hour
