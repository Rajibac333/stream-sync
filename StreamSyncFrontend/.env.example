# =============================================================================
# StreamSync frontend environment
#
# Copy to `.env.local` (git-ignored) and adjust.
#
# ONLY PUBLIC CONFIGURATION BELONGS IN THIS FILE.
# Everything prefixed VITE_ is inlined into the production JavaScript bundle and
# is readable by any user. Never put an AI provider key, database URL, or any
# other secret here — those belong to the Django backend. (CLAUDE.md §66, §79)
# =============================================================================

# Django REST API root.
VITE_API_BASE_URL=http://localhost:8000/api

# Django Channels WebSocket root.
VITE_WS_BASE_URL=ws://localhost:8000/ws

# The API must be running: every screen reads from it and there is no offline
# data set to fall back to. See ../INTEGRATION.md.

# Request timeout, milliseconds.
VITE_API_TIMEOUT=15000

# Enables the /design-system route and React Query devtools.
VITE_ENABLE_DEVTOOLS=true

# "Sign in with Google". Not secret — see app/config.ts — but still
# per-environment: create an OAuth 2.0 Client ID (type "Web application") in
# the Google Cloud Console, add this app's origin(s) under "Authorized
# JavaScript origins", and paste the id below. Must match GOOGLE_OAUTH_CLIENT_ID
# in the backend's own .env — same value, both places. Leaving this unset
# hides the Google button rather than rendering a broken one.
# VITE_GOOGLE_CLIENT_ID=
